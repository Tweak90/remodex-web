# Browser runtime added by the Tweak90 self-hosted fork.
FROM node:22.22.1-bookworm-slim

LABEL org.opencontainers.image.title="remodex-web" \
      org.opencontainers.image.description="Browser interface for an existing Codex gateway" \
      org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY web/ ./
COPY LICENSE /app/LICENSE

USER node
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "/app/web/server.js"]
